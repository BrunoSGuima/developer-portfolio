{
  "name": "developer-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive developer portfolio powered by multiple independently developed applications.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/shell",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test --workspace=e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:todo": "npm run content:todo --workspace=apps/shell"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
