{
  "name": "developer-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive developer portfolio powered by multiple independently developed applications.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/shell",
    "dev:fullstack": "npm run dev:fullstack --workspace=apps/shell",
    "build": "npm run build --workspaces --if-present",
    "build:fullstack": "npm run build:fullstack --workspace=apps/shell",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run e2e --workspace=e2e",
    "test:e2e:static": "E2E_MODE=static npm run e2e --workspace=e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:todo": "npm run content:todo --workspace=apps/shell",
    "content:check": "npm run content:check --workspace=apps/shell",
    "api:types:install": "npm ci --prefix tools/openapi-types --ignore-scripts --no-audit --no-fund",
    "api:types": "node tools/openapi-types/generate.mjs",
    "api:types:check": "node tools/openapi-types/generate.mjs --check"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
