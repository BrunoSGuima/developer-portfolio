{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* The specs import pure modules from the shell (languages, dictionaries, registry), so
       expectations come from the app itself; its React pages are type-checked here too. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,

    /* Type safety (as in the shell) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.smoke.config.ts",
    "support",
    "tests",
    "smoke",
    "../apps/shell/src/env.d.ts"
  ]
}
